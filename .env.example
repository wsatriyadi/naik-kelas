# URL origin publik untuk QR sertifikat dan poster.
APP_URL=https://diklat.example.go.id

# Path database dan storage. Gunakan volume persisten di production.
DATABASE_PATH=./data/diklat.sqlite
STORAGE_PATH=./storage

# Seed data contoh hanya untuk development lokal; production otomatis menonaktifkannya.
SEED_DEMO_DATA=true

# Minimal 32 karakter; wajib diganti pada production.
AUTH_SECRET=change-this-to-a-long-random-secret
